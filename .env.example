# --- LLM (OpenAI-compatible; default = Groq free tier, Ollama offline alt) ---
# Get a free key at https://console.groq.com (no card). Leave blank to run only
# the offline paths (mock LLM in tests, signal tools, detection).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model; the agent falls back down the ladder on rate-limit/error.
LLM_MODEL=openai/gpt-oss-120b

# --- Signals ---
PROMETHEUS_URL=http://localhost:9090
TARGET_URL=http://localhost:8080

# --- Tracing (optional): point at an OTLP backend (e.g. Arize Phoenix) to see
# the agent's reasoning as gen_ai spans. Unset = tracing is a no-op. ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# --- Durable execution (Phase 3): SQLite by default; Postgres for recovery demo ---
# DATABASE_URL=postgresql://incidentpilot:incidentpilot@localhost:5432/incidentpilot

# --- Autonomy / safety ---
# propose_only (never actuates) | auto (actuate when policy authorizes)
INCIDENTPILOT_MODE=propose_only
TARGET_ENV=dev
